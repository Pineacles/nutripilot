# NutriPilot: environment configuration template
# Copy this file to .env and fill in real values (NEVER commit .env)
#
# Generate secrets with: openssl rand -hex 32

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL user (used by all three compose files).
POSTGRES_USER=nutripilot
# PostgreSQL password: the one value you must change everywhere.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# PostgreSQL database name.
POSTGRES_DB=nutripilot
# Full async SQLAlchemy DSN used by the API. docker-compose.yml derives a
# default from the three values above; only set this to point at a database
# that isn't the `db` service in Compose (e.g. an external managed Postgres).
DATABASE_URL=postgresql+asyncpg://nutripilot:CHANGE_ME_STRONG_PASSWORD@db:5432/nutripilot

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signs and verifies all JWT access/refresh tokens. Min 32 chars. Rotating
# this invalidates every existing session and API-key-independent login.
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Fernet key(s) encrypting integration OAuth credentials at rest (see
# app/services/crypto.py). Comma-separated for rotation: the first key
# encrypts new values, all keys can decrypt. Required in production: the app
# refuses to start with ENVIRONMENT=production if this is left at its
# dev-only default. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_PYTHON_FERNET

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins for the dashboard. Required
# in production: the app refuses to start with ENVIRONMENT=production if
# this is left at its dev-only default (http://localhost:3000).
CORS_ORIGINS=https://nutripilot.yourdomain.com,http://localhost:3099

# ── Environment ───────────────────────────────────────────────────────────────
# "dev" (default) or "production". Production disables /docs and /redoc and
# enforces the JWT_SECRET / CORS_ORIGINS / TOKEN_ENCRYPTION_KEY checks above.
# Set automatically by docker-compose.prod.yml / docker-compose.tunnel.yml;
# only needed here if you run the API outside Compose.
ENVIRONMENT=dev

# ── External APIs (optional) ─────────────────────────────────────────────────
# USDA FoodData Central API key (free tier: 1000 req/hour), used as a
# barcode-lookup fallback when a food isn't in the local DB or OpenFoodFacts.
# Get one at: https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=

# ── Seed user (backend/seed.py, run manually via `docker compose exec api
# python -m seed`) ────────────────────────────────────────────────────────────
# Email for the initial dashboard/agent user. Optional, defaults to
# admin@nutripilot.dev.
SEED_EMAIL=admin@example.com
# Password for the initial user. Optional, a strong random password is
# generated and printed once if left unset.
SEED_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Per-user agent API key (X-API-Key header) for the initial user. Optional,
# a random key is generated and printed once if left unset. This is NOT a
# global secret: every user has their own API key, viewable (masked) and
# rotatable from dashboard settings. Give this value to your AI agent's
# configuration if you set it explicitly.
SEED_API_KEY=

# ── Frontend build (docker-compose.prod.yml only) ────────────────────────────
# Base path baked into the Next.js production build at build time. Leave as
# /api unless you're serving the frontend and API from different origins.
NEXT_PUBLIC_API_URL=/api

# ── Reverse proxy (docker-compose.prod.yml only) ─────────────────────────────
# Hostname Caddy requests a TLS cert for and listens on. Defaults to
# "localhost" (no automatic HTTPS) if unset.
DOMAIN=nutripilot.yourdomain.com
