# NutriPilot — environment configuration template
# Copy this file to .env and fill in real values (NEVER commit .env)
#
# Generate secrets with: openssl rand -hex 32

# ── Database ─────────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD is the only value you must change.
# NOTE: If the database volume already exists (initdb already ran), these values
# cannot be changed without wiping the volume. Keep them value-identical.
POSTGRES_USER=nutripilot
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=nutripilot
# Full DSN used by the API (constructed from the above, or override directly)
DATABASE_URL=postgresql+asyncpg://nutripilot:CHANGE_ME_STRONG_PASSWORD@db:5432/nutripilot

# ── Auth ─────────────────────────────────────────────────────────────────────
# JWT secret — used to sign all access/refresh tokens. Min 32 chars.
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Agent API key — used by the AI agent (Seyoung/NanoClaw) for X-API-Key auth.
# IMPORTANT: Do NOT rotate this without also updating the agent configuration.
API_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the browser dashboard.
CORS_ORIGINS=https://nutripilot.yourdomain.com,http://localhost:3099

# ── External APIs (optional) ─────────────────────────────────────────────────
# USDA FoodData Central API key (free tier: 1000 req/hour)
# Get one at: https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=

# Withings OAuth2 client credentials (optional — not required unless you
# want to set up Withings integrations from scratch. Per-integration credentials
# are stored in the integration's field_mapping, not here.)
# WITHINGS_CLIENT_ID=
# WITHINGS_CLIENT_SECRET=

# ── Seed user (used by backend/seed.py only) ─────────────────────────────────
SEED_EMAIL=admin@example.com
SEED_PASSWORD=CHANGE_ME_STRONG_PASSWORD
